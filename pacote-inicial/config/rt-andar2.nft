# Filtragem do rt-andar2. Interfaces: eth0 enlace-andar2, eth1 gama, mgmt0 gerencia.
define INTERNET = 10.80.0.0/24
define GAMA     = 10.80.23.0/24
define GERENTE  = 10.80.250.100

table inet filtro {
    # Prefixo da Gama. A mudança troca o elemento deste conjunto.
    set gama {
        type ipv4_addr; flags interval;
        elements = { $GAMA }
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        iifname "mgmt0" counter drop comment "descarte-de-gerencia"
        oifname "mgmt0" counter drop comment "descarte-para-gerencia"
        ct state established,related accept comment "respostas"
        ip protocol icmp ip saddr != $INTERNET accept comment "icmp-interno"
        iifname "eth1" ip saddr @gama oifname "eth0" accept comment "gama-para-borda"
        counter drop comment "descarte-forward"
    }

    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept comment "local"
        ct state established,related accept comment "respostas"
        iifname "mgmt0" ip saddr $GERENTE udp dport 161 accept comment "snmp-gerente"
        iifname "mgmt0" ip saddr $GERENTE tcp dport 9102 accept comment "nft-gerente"
        ip protocol icmp iifname != "mgmt0" ip saddr != $INTERNET accept comment "icmp-interno"
        counter drop comment "descarte-input"
    }
}
